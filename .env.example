# 複製成 .env 並填入實際值。.env 不會被 git 追蹤 (見 .gitignore)。
# 注意: 不要在「值」後面加註解 (例如 chat_id=123 # me)，程式會把整段當成值。

# CWA 開放資料 API token
# 申請: https://opendata.cwa.gov.tw/ 會員中心 → 取得授權碼 (格式 CWA-XXXX...)
authorization=CWA-XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX

# Telegram Bot token
# 取得: 在 Telegram 找 @BotFather → /newbot 建立後給的 token (格式 數字:字串)
bot_token=123456789:XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# 你的 Telegram chat_id (每日 08:00 推播對象，也是預設白名單成員)
# 查法: 在 Telegram 找 @userinfobot → /start 會回你的 id
chat_id=123456789

# (選填) 允許使用機器人的其他 chat_id，逗號分隔。
# 留空 = 只有上面的 chat_id 能用 (其餘人一律被拒絕、不觸發任何 API)。
# 範例: ALLOWED_CHAT_IDS=111111111,222222222
ALLOWED_CHAT_IDS=
